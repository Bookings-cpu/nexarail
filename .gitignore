rehearsals/validator-agents/*/data/


# Compiled test/utility binaries
*.test
/govtxbuilder
/tools/govtxbuilder/
/tools/storeinspector/

# Runtime evidence (regenerated each run)
rehearsals/*/evidence/
rehearsals/*/logs/
rehearsals/rc1-devnet/

# Portal build output (regenerated from source)
site/

# Large local runtime files
*.db
*.log

# App test files
/app/bench_test.go
/app/governance_test.go
/app/integration_test.go

# SDK test binaries
examples/node-client/node_modules/

# Developer bundle archives (keep manifest + checksums only)
releases/developer-bundles/*.tar.gz


# Agent validator data (contains private keys, node data)
rehearsals/validator-agents/*/config/
rehearsals/validator-agents/*/data/
rehearsals/validator-agents/*/keyring-test/

# Phase 9 validation agent runtime evidence
rehearsals/validator-agents/phase9v-latest-evidence-path.txt
rehearsals/validator-agents/phase9t-latest-evidence-timestamp.txt

# Product flow gov toggle runtime data
rehearsals/validator-agents/product-flows/gov-toggles/

# GitHub Release asset binaries (uploaded via Releases UI, not committed to git)
releases/github/v0.1.0-rc1/nexaraild-*
releases/github/v0.1.0-rc1-hotfix-cli/nexaraild-*

# Mainnet key material (operator/consensus/node keys, mnemonics)
coordination/mainnet-keys/

# Local-only runtime artefacts — do not commit
build/
$OUT/
coordination/operations/
coordination/sentry-deployment-hubmac3-2026-06-17/

# Sensitive operator subdirs — keep public outreach + docs only.
# (Reviewed 2026-06-20: treasury/faucet/incidents/monitoring/validators
# trackers contain wallet addresses, send commands, historical incident
# detail and internal trackers that should not be in the public repo.)
coordination/treasury/
coordination/faucet/
coordination/incidents/
coordination/monitoring/
coordination/mainnet-resubmissions/

# Outreach + validator subdirs — selectively commit only what's intended
# for public consumption. Default to ignored; explicit `git add` is the gate.
# (The public-safe copy pack + discord templates that are already in HEAD
# stay tracked — only new files in these dirs are gated.)
coordination/outreach/
coordination/validators/
